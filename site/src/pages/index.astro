---
import Layout from '../components/Layout.astro';
import ImageList from '../components/ImageList.astro';
import { imageHref } from '../lib/catalog';
import CopyButton from '../components/CopyButton.astro';
import { images, siteStats } from '../lib/catalog';

const stats = siteStats();

// Headline figures, derived from the dataset at build time — never typed in.
const prodSpecs = (i: typeof images[number]) => (i.variants.prod ?? Object.values(i.variants)[0])?.specs;
const sizes = images.map((i) => i.size?.bytes).filter((b): b is number => typeof b === 'number').sort((a, b) => a - b);
const medianMB = sizes.length ? Math.round(sizes[Math.floor(sizes.length / 2)] / 1e6) : null;
const allHaveDev = images.every((i) => 'dev' in i.variants);
const nonRoot = images.filter((i) => (prodSpecs(i)?.uid ?? 0) !== 0).length;
const multiArch = images.filter((i) => {
  const a = prodSpecs(i)?.archs ?? [];
  return a.includes('x86_64') && a.includes('aarch64');
}).length;
const featuredNames = ['python', 'node-slim', 'go', 'nginx', 'postgres-slim', 'redis-slim'];
const featured = featuredNames
  .map((n) => images.find((i) => i.name === n))
  .filter((i): i is NonNullable<typeof i> => Boolean(i));

const verifyCmd = `# Pull — public, no login, no Docker Hub pull limits
docker pull ghcr.io/rtvkiz/minimal-python:latest

# Verify build provenance (SLSA v1.0, Build L2)
gh attestation verify oci://ghcr.io/rtvkiz/minimal-python:latest --owner rtvkiz`;

// Real questions people type before adopting a hardened base image. The answers
// live in the page body (not only in schema) because that is the text an answer
// engine can actually quote — Google retired FAQPage rich results for
// non-authoritative sites in 2023, so the markup below is for machine readers,
// and the section further down is for humans and AI Overviews alike.
const faqs = [
  {
    q: 'Are these hardened container images really free?',
    a: `Yes — all ${stats.images} images are free for any use, including commercial, under the MIT license. There is no paid tier, no free-trial window, and no image held back behind a subscription. The catalogue you see is the whole catalogue.`,
  },
  {
    q: 'Do I need an account to pull them?',
    a: 'No. Images are published to the GitHub Container Registry as public packages, so an anonymous `docker pull` works with no login, no token and none of the Docker Hub anonymous pull-rate limits.',
  },
  {
    q: 'What makes a container image "hardened"?',
    a: 'Here it means four concrete things: the image ships only the packages the application needs, most images have no shell or package manager, the default user is non-root (UID 65532), and every published tag carries a cosign signature, an SPDX SBOM and SLSA v1.0 build provenance you can verify yourself.',
  },
  {
    q: 'How often are the images rebuilt?',
    a: 'Daily. A rebuild picks up new Wolfi packages, so a fix that lands upstream reaches a published tag within 24 hours rather than at the next release. Each rebuild is re-scanned with Grype and the counts are published on this site.',
  },
  {
    q: 'How do these compare to Chainguard, distroless or Docker Hardened Images?',
    a: 'The comparison pages publish head-to-head Grype scans run against a single pinned vulnerability database, including the images where Minimal has more CVEs than the alternative. The short version: comparable hardening and provenance, MIT-licensed and free, with a much smaller catalogue than the commercial vendors.',
  },
  {
    q: 'Can I debug an image with no shell?',
    a: 'Most images ship a `-dev` companion tag that adds a shell and a toolchain. Use the `-dev` variant as the build stage or for interactive debugging, and ship the shell-less production tag.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Minimal Containers',
    url: 'https://minimalcontainers.com',
    logo: 'https://minimalcontainers.com/icon.svg',
    description: `Free, hardened, MIT-licensed container images — ${stats.images} of them, rebuilt daily.`,
    sameAs: ['https://github.com/rtvkiz/minimal'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Minimal Containers',
    url: 'https://minimalcontainers.com',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<Layout schema={schema}>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div>
          <h1>Free hardened container images</h1>
          <p class="lead">Small, signed container images, rebuilt every day. Free to pull — no account needed.</p>
          <form class="hero-search" action="/images/" method="get" role="search">
            <label class="field search">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="7" cy="7" r="4.5" /><path d="m10.5 10.5 3 3" stroke-linecap="round" /></svg>
              <span class="visually-hidden">Search images</span>
              <input name="q" type="search" placeholder={`Search ${stats.images} images — postgres, nginx, python…`} autocomplete="off" autocapitalize="off" spellcheck="false" />
            </label>
            <button class="btn btn-primary" type="submit">Search</button>
          </form>
          <p class="hero-popular">
            <span>Popular:</span>
            {featured.map((img) => <a href={imageHref(img.name)}>{img.displayName}<span class="visually-hidden"> image</span></a>)}
          </p>
        </div>
        <div>
          <div class="terminal">
            <div class="terminal-bar"><span>Pull and verify in 30 seconds</span></div>
            <CopyButton code={verifyCmd} />
          </div>
          <p class="small" style="margin:10px 0 0"><a href="/about/">All verification commands →</a></p>
        </div>
      </div>

      <div class="stats" style="margin-top:48px">
        <div class="stat"><div class="num">{stats.images}</div><div class="lbl">{allHaveDev ? 'Images, each with a -dev variant' : 'Images'}</div></div>
        <div class="stat"><div class="num">{multiArch === stats.images ? 'All' : multiArch}</div><div class="lbl">Built for amd64 and arm64</div></div>
        <div class="stat"><div class="num">{nonRoot}</div><div class="lbl">Run as non-root by default</div></div>
        {medianMB !== null && <div class="stat"><div class="num">{medianMB} MB</div><div class="lbl">Median compressed size</div></div>}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <div>
          <h2 class="section-title">Popular images</h2>
          <p class="section-sub">With their latest scan results.</p>
        </div>
        <a href="/images/" class="small">View all {stats.images} images →</a>
      </div>
      <ImageList images={featured} />
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <div class="split">
        <div>
          <h2 class="section-title">What every image ships with</h2>
          <p class="section-sub">The same guarantees on every production tag, each checkable from your terminal.</p>
        </div>
        <div class="verify-grid two">
          <div class="feature"><h3>Cosign keyless signature</h3><p>Verifiable against the public Rekor transparency log — no keys to manage.</p></div>
          <div class="feature"><h3>SPDX SBOM attestation</h3><p>Every package, version and license, attached as an in-toto attestation.</p></div>
          <div class="feature"><h3>SLSA v1.0 provenance</h3><p>Cryptographic proof of which workflow, commit and runner built the image.</p></div>
          <div class="feature"><h3>CVE scan every rebuild</h3><p>Grype runs on every production image each cycle; results published here and in the GitHub Security tab.</p></div>
          <div class="feature"><h3>Non-root by default</h3><p>Runs as UID 65532 unless the upstream insists otherwise.</p></div>
          <div class="feature"><h3>No shell where possible</h3><p>Most images don't ship /bin/sh, shrinking the attack surface.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="split">
        <div>
          <h2 class="section-title">Common questions</h2>
          <p class="section-sub">Short answers to what people ask before swapping a base image.</p>
        </div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p set:html={f.a.replace(/`([^`]+)`/g, '<code>$1</code>')} />
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
