---
import Layout from '../../components/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Layout title={`${post.data.title} — Minimal Containers`} description={post.data.description} published={post.data.published}>
  <section>
    <div class="container-narrow">
      <p style="margin:0 0 6px"><a href="/blog" class="small muted">← Blog</a></p>
      <h1 class="section-title">{post.data.title}</h1>
      <p class="small muted">
        <time datetime={post.data.published}>{fmt(post.data.published)}</time>
        {post.data.updated && <> · updated <time datetime={post.data.updated}>{fmt(post.data.updated)}</time></>}
      </p>
      <article class="prose" style="margin-top:28px">
        <Content />
      </article>
    </div>
  </section>
</Layout>
