---
import Layout from '../../components/Layout.astro';
import ImageTable from '../../components/ImageTable.astro';
import { byCategory, categories, images, imageHref } from '../../lib/catalog';
const grouped = byCategory();
const sorted = [...images].sort((a, b) => a.displayName.localeCompare(b.displayName, 'en', { sensitivity: 'base' }));

// ItemList tells a crawler this is a catalogue and what is in it, rather than
// leaving it to infer structure from a wall of rows.
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Minimal Containers image directory',
  numberOfItems: images.length,
  itemListElement: images.map((img, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `minimal-${img.name}`,
    url: new URL(imageHref(img.name), Astro.site).href,
  })),
}];
---
<Layout
  title={`All ${images.length} hardened container images — free and signed`}
  description={`Browse ${images.length} free, hardened container images across ${categories.length} categories — databases, proxies, observability, Kubernetes tooling and language runtimes. MIT-licensed, signed, rebuilt daily.`}
  schema={schema}
  breadcrumbs={[]}>
  <div class="page-head" style="border-bottom:0;padding-bottom:8px">
    <div class="container">
      <h1>All {images.length} hardened container images</h1>
    </div>
  </div>

  <div class="toolbar">
    <div class="container">
      <div class="toolbar-row">
        <label class="field search">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="7" cy="7" r="4.5" /><path d="m10.5 10.5 3 3" stroke-linecap="round" /></svg>
          <span class="visually-hidden">Search images</span>
          <input id="search" type="search" placeholder="Search by name or description" autocomplete="off" autocapitalize="off" spellcheck="false" />
          <kbd aria-hidden="true">/</kbd>
        </label>
        <label class="field">
          <span>Sort</span>
          <select id="sort">
            <option value="name">Name</option>
            <option value="category">Category</option>
            <option value="cves">Fewest vulnerabilities</option>
            <option value="size">Smallest</option>
            <option value="updated">Recently built</option>
          </select>
        </label>
        <span class="result-count" id="count" aria-live="polite"></span>
      </div>
      <div class="facets" id="facets" role="group" aria-label="Filter by category">
        <button type="button" class="facet" data-cat="all" aria-pressed="true">All</button>
        {categories.map((c) => (
          <button type="button" class="facet" data-cat={c} aria-pressed="false">{c} <span class="count">{grouped[c]?.length ?? 0}</span></button>
        ))}
      </div>
    </div>
  </div>

  <div class="container">
    <ImageTable images={sorted} sortable id="catalog" />
    <p id="noresults" class="empty-state" hidden>
      No images match your filters. <button type="button" class="btn btn-ghost" id="reset" style="margin-left:8px;height:32px">Clear filters</button>
    </p>
  </div>
</Layout>

<script>
  const search = document.getElementById('search') as HTMLInputElement;
  const sortSel = document.getElementById('sort') as HTMLSelectElement;
  const count = document.getElementById('count') as HTMLElement;
  const noresults = document.getElementById('noresults') as HTMLElement;
  const table = document.getElementById('catalog') as HTMLTableElement;
  const tbody = table.tBodies[0];
  const rows = Array.from(tbody.rows);
  const facets = Array.from(document.querySelectorAll<HTMLButtonElement>('#facets .facet'));
  const headers = Array.from(table.querySelectorAll<HTMLTableCellElement>('th[data-key]'));
  const total = rows.length;

  type Dir = 'asc' | 'desc';
  // The natural first direction for each column: newest builds first, everything else ascending.
  const defaultDir = (k: string): Dir => (k === 'updated' ? 'desc' : 'asc');
  const state = { q: '', cat: 'all', key: 'name', dir: 'asc' as Dir };

  // Restore from the URL so a filtered view is linkable.
  const params = new URLSearchParams(location.search);
  state.q = params.get('q') ?? '';
  const urlCat = params.get('category');
  if (urlCat && facets.some((f) => f.dataset.cat === urlCat)) state.cat = urlCat;
  const urlSort = params.get('sort');
  if (urlSort && /^(name|category|cves|size|updated):(asc|desc)$/.test(urlSort)) {
    const [k, d] = urlSort.split(':');
    state.key = k; state.dir = d as Dir;
  }
  search.value = state.q;

  // Unscanned (-1) and unknown sizes sort last whatever the direction.
  function value(row: HTMLTableRowElement, key: string): string | number | null {
    const d = row.dataset;
    switch (key) {
      case 'cves': { const n = Number(d.cves); return n < 0 ? null : n; }
      case 'size': return d.size ? Number(d.size) : null;
      case 'updated': return d.updated || null;
      case 'category': return d.category || '';
      default: return d.name || '';
    }
  }

  function render() {
    const q = state.q.trim().toLowerCase();
    const sorted = [...rows].sort((a, b) => {
      const va = value(a, state.key), vb = value(b, state.key);
      if (va === null && vb === null) return 0;
      if (va === null) return 1;
      if (vb === null) return -1;
      const cmp = typeof va === 'number' && typeof vb === 'number'
        ? va - vb
        : String(va).localeCompare(String(vb), 'en', { sensitivity: 'base' });
      return (state.dir === 'asc' ? cmp : -cmp) || (a.dataset.name || '').localeCompare(b.dataset.name || '');
    });
    let visible = 0;
    for (const row of sorted) {
      const show = (state.cat === 'all' || row.dataset.category === state.cat)
        && (!q || (row.dataset.search || '').includes(q));
      row.hidden = !show;
      if (show) visible++;
      tbody.appendChild(row);
    }
    // Only worth saying when a filter is hiding something.
    count.textContent = visible === total ? '' : `${visible} of ${total}`;
    noresults.hidden = visible !== 0;
    table.hidden = visible === 0;
    for (const f of facets) f.setAttribute('aria-pressed', String(f.dataset.cat === state.cat));
    for (const h of headers) {
      if (h.dataset.key === state.key) h.setAttribute('aria-sort', state.dir === 'asc' ? 'ascending' : 'descending');
      else h.removeAttribute('aria-sort');
      const arrow = h.querySelector('.arrow');
      if (arrow) arrow.textContent = h.dataset.key === state.key && state.dir === 'desc' ? '▼' : '▲';
    }
    sortSel.value = state.key;
    const opt = `${state.key}:${state.dir}`;

    const next = new URLSearchParams();
    if (state.q) next.set('q', state.q);
    if (state.cat !== 'all') next.set('category', state.cat);
    if (opt !== 'name:asc') next.set('sort', opt);
    const qs = next.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  search.addEventListener('input', () => { state.q = search.value; render(); });
  sortSel.addEventListener('change', () => {
    state.key = sortSel.value; state.dir = defaultDir(state.key); render();
  });
  for (const f of facets) f.addEventListener('click', () => { state.cat = f.dataset.cat || 'all'; render(); });
  for (const b of Array.from(table.querySelectorAll<HTMLButtonElement>('.sort-btn'))) {
    b.addEventListener('click', () => {
      const k = b.dataset.sort!;
      if (state.key === k) state.dir = state.dir === 'asc' ? 'desc' : 'asc';
      else { state.key = k; state.dir = defaultDir(k); }
      render();
    });
  }
  document.getElementById('reset')?.addEventListener('click', () => {
    state.q = ''; state.cat = 'all'; search.value = ''; render(); search.focus();
  });
  // "/" jumps to search, as in most developer tools.
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !e.metaKey && !e.ctrlKey && !/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) {
      e.preventDefault(); search.focus();
    }
  });
  render();
</script>
