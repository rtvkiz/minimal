---
// The image directory as a table: one row per image, sortable by the columns
// people actually compare on. Below 760px rows restack into a two-line list
// (see .dir in global.css). Every row is server-rendered, so the full list
// is in the HTML for crawlers and for anyone with JavaScript disabled.
import type { ImageRecord } from '../lib/catalog';
import { imageHref, categorySlug, shortDescription } from '../lib/catalog';
import VulnSummary from './VulnSummary.astro';
export interface Props { images: ImageRecord[]; showCategory?: boolean; sortable?: boolean; id?: string; }
const { images, showCategory = true, sortable = false, id } = Astro.props;
const cves = (i: ImageRecord) => (i.vulnerabilities ? i.vulnerabilities.total : -1);
const blurb = (i: ImageRecord) => shortDescription(i);
const head = (key: string, label: string, right = false) => (
  { key, label, right }
);
const cols = [
  head('name', 'Image'),
  ...(showCategory ? [head('category', 'Category')] : []),
  head('cves', 'Vulnerabilities'),
  head('size', 'Size', true),
  head('updated', 'Built', true),
];
---
<table class="dir" id={id}>
  <thead>
    <tr>
      {cols.map((c) => (
        <th scope="col" class={c.right ? 'r' : undefined} data-key={c.key} aria-sort={sortable && c.key === 'name' ? 'ascending' : undefined}>
          {sortable
            ? <button class="sort-btn" type="button" data-sort={c.key}>{c.label}<span class="arrow" aria-hidden="true">▲</span></button>
            : c.label}
        </th>
      ))}
    </tr>
  </thead>
  <tbody>
    {images.map((img) => (
      <tr
        data-name={img.displayName.toLowerCase()}
        data-category={img.category}
        data-cves={cves(img)}
        data-size={img.size?.bytes ?? ''}
        data-updated={img.builtAt ?? ''}
        data-search={`${img.name} ${img.displayName} ${blurb(img)} ${img.category}`.toLowerCase()}>
        <td class="c-name">
          <a class="img-name" href={imageHref(img.name)}>{img.displayName}</a>
          <div class="img-desc" title={blurb(img)}>{blurb(img)}</div>
        </td>
        {showCategory && (
          <td class="c-cat"><a class="cat-link" href={`/images/category/${categorySlug(img.category)}/`}>{img.category}</a></td>
        )}
        <td class="c-cve"><VulnSummary image={img} /></td>
        <td class="c-size num r">{img.size ? img.size.human : '—'}</td>
        <td class="c-age age r">{img.updatedAgo ?? '—'}</td>
        <td class="c-meta age">{[img.size?.human, img.updatedAgo].filter(Boolean).join(' · ') || '—'}</td>
      </tr>
    ))}
  </tbody>
</table>
